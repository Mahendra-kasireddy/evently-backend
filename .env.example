# ============================================================================
# Evently API — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Keys marked (required) must be present or the app fails fast at boot
# (see src/config/env.validation.ts).
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development            # development | production
PORT=3000
API_PREFIX=api
SWAGGER_ENABLED=false           # OpenAPI docs at /api/docs; auto-on in dev, set true to force in prod

# --- MongoDB (required) ----------------------------------------------------
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/<db>   Local: mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=evently_db

# --- Redis (used by BullMQ; required if background queues are enabled) ------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                 # leave blank for local/no-auth Redis
REDIS_DB=0
BULLMQ_PREFIX=evently

# --- JWT (required — each secret must be >= 32 chars) -----------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_32plus_char_random_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_me_with_a_different_32plus_char_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- OTP auth --------------------------------------------------------------
OTP_DELIVERY=stub               # stub logs the code; swap when a real SMS provider is wired
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=15
OTP_MAX_ACTIVE=5
OTP_DEFAULT_DIAL_CODE=+91
OTP_SMS_API_KEY=                # only needed for a real SMS gateway

# --- Socket.IO / realtime --------------------------------------------------
SOCKET_IO_PATH=/socket.io
SOCKET_IO_CORS_ORIGIN=*         # lock to your web origin in production
WS_NAMESPACE=/ws
YJS_NAMESPACE=/yjs

# --- Optional integrations (NOT wired yet — leave blank) -------------------
# Email (SMTP), SMS (Twilio) and push (Firebase) providers are not connected
# in the current build. These placeholders exist so a future provider can be
# dropped in without re-shaping config. Safe to leave empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
