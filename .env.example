# Evently backend — environment template.
# Copy to `.env` for local development. Never commit real values; production
# values live in Render's Environment settings. Every key is checked at
# startup by src/config/env.validation.ts.

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
PAYMENTS_TEST_MODE=false

# --- MongoDB (required) ----------------------------------------------------
MONGO_URI=
MONGO_DB_NAME=

# --- Redis / BullMQ --------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
BULLMQ_PREFIX=evently

# --- Auth (required; at least 32 characters each) --------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- OTP: `test` (fixed code, no SMS) or `twilio` (needs the TWILIO_* keys) --
OTP_MODE=test
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=15
OTP_MAX_ACTIVE=5
OTP_DEFAULT_DIAL_CODE=+91
OTP_SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Realtime ---------------------------------------------------------------
SOCKET_IO_PATH=/socket.io
SOCKET_IO_CORS_ORIGIN=*
WS_NAMESPACE=/ws
YJS_NAMESPACE=/yjs

# --- Mail (optional) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Push / Firebase (optional) ---------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Uploads ----------------------------------------------------------------
# `cloudinary` in production (the default when NODE_ENV=production; `local` is
# refused there because the container disk is wiped on every deploy).
# `local` for development: files go under UPLOAD_LOCAL_DIR.
UPLOAD_DRIVER=local
# Optional. Under Cloudinary it defaults to https://res.cloudinary.com/<cloud>.
UPLOAD_PUBLIC_BASE_URL=
UPLOAD_LOCAL_DIR=uploads
# Required when UPLOAD_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder every asset is stored under (default: evently).
CLOUDINARY_FOLDER=

# --- WhatsApp guest sharing: `handoff` or `cloud` ----------------------------
WHATSAPP_DELIVERY=handoff
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_GRAPH_VERSION=

# --- Public link bases --------------------------------------------------------
PUBLIC_API_URL=
PUBLIC_WEB_URL=
PUBLIC_APP_LINK=

# --- Razorpay (optional; payment routes report when it is missing) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
